// Resources of papier.exe (tools/papiertool build passes it on Windows).
//   id 1, ICON         the icon: Explorer, the Start menu's shortcut, Settings > Apps, the window and the taskbar
//                      (platform.open_window loads id 1). Made by papiertool logo.
//   id 1, RT_MANIFEST  runs as the user who starts it, Windows 10 and 11, per-monitor DPI aware.
//   id 1, VERSIONINFO  publisher, product and version (Properties > Details): APP_VERSION's numbers, through
//                      build/version.h, which papiertool build writes.
#include "../build/version.h"

1 ICON "..\\assets\\papier.ico"
1 24 "papier.manifest"

1 VERSIONINFO
FILEVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Froment Software"
            VALUE "FileDescription", "Papier"
            VALUE "FileVersion", VER_STRING
            VALUE "InternalName", "papier"
            VALUE "LegalCopyright", "Copyright (c) 2026 sachahjkl"
            VALUE "OriginalFilename", "papier.exe"
            VALUE "ProductName", "Papier"
            VALUE "ProductVersion", VER_STRING
            VALUE "Comments", "The clipboard's history."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
